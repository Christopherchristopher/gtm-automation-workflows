          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst raw = $input.first().json.output[0].content[0].text;\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parsed = { intent: 'unknown', urgency: 'medium', sentiment: 'neutral', suggested_team: 'general' };\n}\n\nconst urgencyToPriority = {\n  low: 'low',\n  medium: 'normal',\n  high: 'high',\n  critical: 'urgent'\n};\n\nreturn [{\n  json: {\n    ticket_id: $('New Ticket Trigger').item.json.body.ticket.id,\n    intent: parsed.intent,\n    urgency: parsed.urgency,\n    sentiment: parsed.sentiment,\n    suggested_team: parsed.suggested_team,\n    priority: urgencyToPriority[parsed.urgency] || 'normal',\n    is_critical: parsed.urgency === 'critical' || parsed.sentiment === 'very_negative'\n  }\n}];"
      },
